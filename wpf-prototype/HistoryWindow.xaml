<Window x:Class="Catalyst.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalyst — Recent conversions"
        Height="360" Width="460"
        MinHeight="240" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Recent conversions" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ClearButton" Content="Clear" Width="75" Margin="0,0,8,0" Click="ClearButton_Click"/>
            <Button Content="Close" Width="75" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
        <ListBox x:Name="HistoryList" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0"
                                VerticalAlignment="Center" Padding="8,2"
                                Click="OpenFolder_Click"/>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
