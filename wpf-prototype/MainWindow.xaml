<Window x:Class="Catalyst.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalyst"
        Icon="Assets/Catalyst.ico"
        Height="260" Width="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Canvas Width="260" Height="260">

        <!-- Format picker nodes, hidden until a file is dragged over the nucleus -->
        <Grid x:Name="NodeTop" Canvas.Left="108" Canvas.Top="18" Width="44" Height="44" Visibility="Collapsed">
            <Ellipse x:Name="NodeTopEllipse" Fill="#B5D4F4" Stroke="#185FA5" StrokeThickness="1.5"/>
            <TextBlock x:Name="NodeTopText" Foreground="#042C53" FontSize="10" FontWeight="Medium"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="NodeRight" Canvas.Left="198" Canvas.Top="108" Width="44" Height="44" Visibility="Collapsed">
            <Ellipse x:Name="NodeRightEllipse" Fill="#B5D4F4" Stroke="#185FA5" StrokeThickness="1.5"/>
            <TextBlock x:Name="NodeRightText" Foreground="#042C53" FontSize="10" FontWeight="Medium"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="NodeBottom" Canvas.Left="108" Canvas.Top="198" Width="44" Height="44" Visibility="Collapsed">
            <Ellipse x:Name="NodeBottomEllipse" Fill="#B5D4F4" Stroke="#185FA5" StrokeThickness="1.5"/>
            <TextBlock x:Name="NodeBottomText" Foreground="#042C53" FontSize="10" FontWeight="Medium"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="NodeLeft" Canvas.Left="18" Canvas.Top="108" Width="44" Height="44" Visibility="Collapsed">
            <Ellipse x:Name="NodeLeftEllipse" Fill="#B5D4F4" Stroke="#185FA5" StrokeThickness="1.5"/>
            <TextBlock x:Name="NodeLeftText" Foreground="#042C53" FontSize="10" FontWeight="Medium"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Nucleus: the main drop target, always visible -->
        <Grid Canvas.Left="84" Canvas.Top="84" Width="92" Height="92">
            <Ellipse x:Name="Nucleus" Fill="#185FA5" Stroke="#0C447C" StrokeThickness="2"/>
            <TextBlock x:Name="StatusText"
                       Text="drop file"
                       Foreground="#E6F1FB"
                       FontSize="13"
                       FontWeight="Medium"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

    </Canvas>
</Window>
