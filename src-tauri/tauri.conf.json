{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catalyst",
  "version": "0.1.0",
  "identifier": "com.arjunmaybe.catalyst",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Catalyst",
        "width": 260,
        "height": 260,
        "minWidth": 260,
        "minHeight": 260,
        "maxWidth": 260,
        "maxHeight": 260,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "Arjun Sasi",
    "category": "Utility",
    "shortDescription": "Floating file converter for Windows.",
    "longDescription": "Catalyst is a floating file converter for Windows. Drag a file onto the widget and drop it on a format node; the converted copy lands next to the original. All conversion runs locally.",
    "copyright": "Copyright (c) 2026 Arjun Sasi. All rights reserved.",
    "homepage": "https://github.com/arjunmaybe/Catalyst",
    "license": "Proprietary — see EULA.md. FFmpeg sidecar remains under GPL-3.0-or-later, see THIRD-PARTY-NOTICES.md.",
    "licenseFile": "../EULA.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../THIRD-PARTY-NOTICES.md",
      "../EULA.md",
      "../licenses/GPL-3.0-or-later.txt"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "signCommand": null,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
